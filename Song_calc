# -*- coding: utf-8 -*-
"""
Gyruda decking calculator
Inputs - Deck size, clones* in deck
*clones is a sum total of clones and reanimation effects that function as clones
    Basic: Cast Gyruda on turn 5. Do you deck yourself?
"""
import numpy as np
from mpl_toolkits.mplot3d import Axes3D  
# Axes3D import has side effects, it enables using projection='3d' in add_subplot
import matplotlib.pyplot as plt
import statistics
import random

Starting_deck=99
opening_hand=7
land_fetches=4 #rampant growth effects, and fetch lands marginally reduce deck size
start_turn=5
Clones_hand=2
gyr_try=4
Clones_min=25
Clones_max=36
SimDeck=[]
N_c_plot_list=[]
result_plot_list=[]
for N_c in range(Clones_min,Clones_max):
    Ind_result=[] #output list for the individual simulation
    GY_c=0 #graveyard counter start
    Clones_remaining=N_c-Clones_hand #define loop start parameters 
    D_start = Starting_deck-start_turn-opening_hand-land_fetches #define loop start parameters
    for stat_s in range(1000): #statistically significant simulation   
        D_s=D_start
        SimDeck.clear() #clear deck list
        x=0 #resetting counters
        y=0 #resetting counters
        for x in range(Clones_remaining):
            SimDeck.append(1)
        for y in range(D_s-Clones_remaining):
            SimDeck.append(0)
        random.shuffle(SimDeck) #shuffle the deck
        #print(SimDeck)
        #resolving Gyruda and subsequent clones trigger
        i=1 #initial trigger
        while i>0:
            #Deck check!
            D_s=len(SimDeck)
            if D_s>=4:
                repeat=SimDeck[gyr_try-4]+SimDeck[gyr_try-3]+SimDeck[gyr_try-2]+SimDeck[gyr_try-1]
                b=0
                for b in range(gyr_try):
                    SimDeck.pop(0)
            else:
                repeat=0
            i=repeat
        Ind_result.append(D_s)
    N_c_plot_list.append(N_c)
    result_plot_list.append(statistics.mean(Ind_result))
print(N_c_plot_list,result_plot_list)
