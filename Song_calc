        #shuffle the deck
        random.shuffle(SimDeck)
    
        #print(SimDeck)
    
        #resolving Gyruda and subsequent clones trigger
        i=1
        while i>0:
            #Deck check!
            D_s=len(SimDeck)
            if D_s<=4:
                repeat=0
            else:
                repeat=SimDeck[gyr_try-4]+SimDeck[gyr_try-3]+SimDeck[gyr_try-2]+SimDeck[gyr_try-1]
                b=0
                for b in range(gyr_try):
                    del SimDeck[0]
                    #GY_c=GY_c+(Repeat-1)
            i=repeat
    
            #print(comp)
            #print(SimDeck)
            #print(GY_c)
        result.append(D_s)
        result_avg=statistics.mean(result)
    N_c_plot_list.append(N_c)
    result_plot_list.append(result_avg)
print(N_c_plot_list,result_plot_list)
