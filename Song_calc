# -*- coding: utf-8 -*-
"""
Gyruda decking calculator
Inputs - Deck size, clones* in deck
*clones is a sum total of clones and reanimation effects that function as clones
    Basic: Cast Gyruda on turn 6. Do you deck yourself?
"""
import numpy as np
from mpl_toolkits.mplot3d import Axes3D  
# Axes3D import has side effects, it enables using projection='3d' in add_subplot
import matplotlib.pyplot as plt
import random

Starting_deck=99
Clones_start=25
opening_hand=7
start_turn=6
Clones_hand=2
Gyr_try=4
Clones_remaining=Clones_start=Clones_hand #define loop start parameters 
D_s = Starting_deck-start_turn-opening_hand #define loop start parameters

#create deck array
SimDeck=[]
For x in Clones_remaining
    SimDeck.append[1]
For x in (D_s-Clones_remaining)
    SimDeck.append[0]
random.shuffle(SimDeck)
#print(SimDeck)

#resolving Gyruda and subsequent clones trigger

i=1
While i>0
#Deck check!
GW=len(SimDeck)
If GW<4:
    repeat=0
Else:
    Repeat=SimDeck[Gry_try-4]+SimDeck[Gry_try-3]+SimDeck[Gry_try-2]+SimDeck[Gry_try-1]
    SimDeck=SimDeck.del[0,1,2,3]
    GY_c=Repeat-1
i=Repeat

print(GW)
print(SimDeck)
print(GY_c)
