"""
Gyruda decking calculator
Inputs - Deck size, clones* in deck
*clones is a sum total of clones and reanimation effects that function as clones
    Basic: Cast Gyruda on turn 5. Do you deck yourself?
"""
import numpy as np
from mpl_toolkits.mplot3d import Axes3D  
# Axes3D import has side effects, it enables using projection='3d' in add_subplot
import matplotlib.pyplot as plt
import statistics
import random

Starting_deck=99
opening_hand=7
land_fetches=3 #rampant growth effects, and fetch lands
start_turn=5
Clones_hand=2
gyr_try=4
Clones_min=25
Clones_max=30
result=[] #output array
N_c_plot_list=[]
#result_plot_list=[]
for N_c in range(Clones_min,Clones_max):

    Clones_remaining=N_c-Clones_hand #define loop start parameters 
    D_s = Starting_deck-start_turn-opening_hand-land_fetches #define loop start parameters

    #create deck array
    SimDeck=[]
    for x in range(Clones_remaining):
        SimDeck.append(1)
    for y in range(D_s-Clones_remaining):
        SimDeck.append(0)

    #shuffle the deck
    random.shuffle(SimDeck)

    #print(SimDeck)

    #resolving Gyruda and subsequent clones trigger
    i=1
    while i>0:
        #Deck check!
        D_s=len(SimDeck)
        if D_s<=4:
            repeat=0
        else:
            repeat=SimDeck[gyr_try-4]+SimDeck[gyr_try-3]+SimDeck[gyr_try-2]+SimDeck[gyr_try-1]
            b=0
            for b in range(gyr_try):
                del SimDeck[0]
            #GY_c=GY_c+(Repeat-1) FIGURE OUT THE GRAVEYARD COUNTER
        i=repeat
    result.append(D_s)
    N_c_plot_list.append(N_c)
print(N_c_plot_list,result)
